# Supabase — LAMAS PROJECT (ref evvneasquyrorzekfqql)
#
# Committed on purpose. Both values are NEXT_PUBLIC_, so Next.js inlines them
# into the client bundle and serves them to every visitor regardless — they are
# public by design, and row-level security is what actually protects the data.
# Keeping them here means the deployed build is configured without depending on
# dashboard environment variables being set.
#
# The service_role key is the opposite: it bypasses RLS entirely and must never
# be committed or exposed to the browser.
#
# .env.local (git-ignored) overrides this file for local development.
NEXT_PUBLIC_SUPABASE_URL=https://evvneasquyrorzekfqql.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ewdODqSBqV2EIGv1k7aV1w_E1wpawjC
